const CurvedText = ({
  text,
  tilt,
  lift,
  peak = 0.5,
  colors,
  className,
}: {
  text: string;
  tilt: number;
  lift: number;
  peak?: number;
  colors?: string[];
  className?: string;
}) => {
  const last = text.length - 1;
  const mid = last * peak;
  const span = Math.max(mid, last - mid);
  let colorIndex = 0;

  let cursor = 0;
  const words = text.split(" ").map((word) => {
    const start = cursor;
    cursor += word.length + 1;
    return { word, start };
  });

  return (
    <span aria-label={text} className={cn("inline-block", className)}>
      {words.map(({ word, start }, w) => (
        <Fragment key={w}>
          {w > 0 && (
            <span aria-hidden="true" className="inline-block w-[0.25em]" />
          )}
          <span className="inline-block whitespace-nowrap">
            {word.split("").map((char, k) => {
              const i = start + k;
              const t = (i - mid) / span;
              const rotate = t * tilt;
              const y = (t * t - 1) * lift;
              const color = colors?.[colorIndex++ % colors.length];
              return (
                <span
                  key={k}
                  aria-hidden="true"
                  className={cn("inline-block", color)}
                  style={{
                    transform: `translateY(${y}em) rotate(${rotate}deg)`,
                  }}
                >
                  {char}
                </span>
              );
            })}
          </span>
        </Fragment>
      ))}
    </span>
  );
};

