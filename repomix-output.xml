.reveal {
  opacity: 0;
  transition:
    opacity var(--duration, 600ms) ease var(--delay, 0ms),
    transform var(--duration, 600ms) ease var(--delay, 0ms);
  will-change: opacity, transform;
}

.reveal-fade { transform: translate3d(0, 28px, 0); }
.reveal-left { transform: translate3d(-90px, 0, 0); }
.reveal-right { transform: translate3d(90px, 0, 0); }
.reveal-flip-left { transform: perspective(2500px) rotateY(-100deg); transform-origin: left center; }
.reveal-flip-up { transform: perspective(2500px) rotateX(-100deg); transform-origin: center bottom; }
.reveal-zoom { transform: scale(.72); }
.reveal.is-visible { opacity: 1; transform: none; }

.reveal-wipe,
.reveal-wipe-down {
  position: relative;
  overflow: hidden;
}

.reveal-wipe > *,
.reveal-wipe-down > * { opacity: 0; }

.reveal-wipe.is-visible,
.reveal-wipe-down.is-visible {
  opacity: 1;
  transform: none;
}

.reveal-wipe.is-visible > *,
.reveal-wipe-down.is-visible > * {
  animation: revealInner .01s linear calc(var(--duration, 600ms) + var(--delay, 0ms)) forwards;
}

.reveal-wipe::after,
.reveal-wipe-down::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(90deg, transparent, #28c39b);
  transform: scaleX(0);
  transform-origin: left center;
}

.reveal-wipe.is-visible::after {
  animation: wipeInX var(--duration, 600ms) ease var(--delay, 0ms), wipeOutX var(--duration, 600ms) ease calc(var(--duration, 600ms) + var(--delay, 0ms));
}

.reveal-wipe-down::after {
  background: linear-gradient(180deg, transparent, #28c39b);
  transform: scaleY(0);
  transform-origin: top center;
}

.reveal-wipe-down.is-visible::after {
  animation: wipeInY var(--duration, 600ms) ease var(--delay, 0ms), wipeOutY var(--duration, 600ms) ease calc(var(--duration, 600ms) + var(--delay, 0ms));
}

@keyframes revealInner { to { opacity: 1; } }
@keyframes wipeInX {
  from { transform: scaleX(0); transform-origin: left center; }
  to { transform: scaleX(1); transform-origin: left center; }
}
@keyframes wipeOutX {
  from { transform: scaleX(1); transform-origin: right center; }
  to { transform: scaleX(0); transform-origin: right center; }
}
@keyframes wipeInY {
  from { transform: scaleY(0); transform-origin: top center; }
  to { transform: scaleY(1); transform-origin: top center; }
}
@keyframes wipeOutY {
  from { transform: scaleY(1); transform-origin: bottom center; }
  to { transform: scaleY(0); transform-origin: bottom center; }
}
@keyframes faqOpen {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes cookieIn {
  from { opacity: 0; transform: translateX(-50%) scale(.95); }
  to { opacity: 1; transform: translateX(-50%) scale(1); }
}

