.gallery {
  position: relative;
  width: 75%;
  height: 579px;
  margin-inline: auto;
  overflow: hidden;
  outline: none;
}

.gallery-track {
  height: 100%;
  display: flex;
  transition: transform .75s ease;
}

.gallery-track img {
  min-width: 100%;
  height: 100%;
  object-fit: cover;
}

.gallery-prev,
.gallery-next,
.gallery-pause {
  position: absolute;
