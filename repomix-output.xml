@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@layer base {
  html {
    @apply font-sans;
    }
}

#top {
  overflow-x: clip;
}


.page-shell {
  width: min(100%, 1120px);
  margin-inline: auto;
  padding-inline: 25px;
}

.section-shell { padding-inline: 45px; }

h1, h2, h3, h4, h5, h6 {
  margin: 0;
  font-family: 'EB Garamond', Georgia, serif;
  font-weight: 700;
  line-height: 1.4;
}

/* Correo ofuscado (franxa de contacto e FAQ): o <button> non leva href para non
   expoñer o enderezo no DOM, así que hai que quitar lle o aspecto de botón e
   deixar que o texto se poida seleccionar para copiar. */
.protected-email {
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  user-select: text;
  cursor: pointer;
}

/* O enderezo escríbese invertido no DOM; con isto vese na orde correcta. */
.protected-email-address {
  direction: rtl;
  unicode-bidi: bidi-override;
}

.contact-strip .page-shell > :last-child { justify-self: end; }
.contact-strip svg { width: 20px; height: 20px; }

.site-header {
  height: 68px;
  background: #fff;
  z-index: 20;
}

.site-header.is-sticky {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.3);
}

h1,h2,h3,h4,h5,h6, p{
   color: #1a1a1a80 !important; 
}
.navigation {
