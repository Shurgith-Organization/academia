<file path="components/lib/scrollToSection.js">
export function scrollToSection(href, { behavior } = {}) {
  const el = document.getElementById(href.replace(/^#/, ''))
  if (!el) return false

  const rect = el.getBoundingClientRect()
  const header = document.querySelector('header')
  const margin = (header?.offsetHeight ?? 0) + 16
  const available = window.innerHeight - margin * 2

  const centered =
    rect.height >= available
      ? rect.top + window.scrollY - margin
      : rect.top + window.scrollY - (window.innerHeight - rect.height) / 2

  const max = document.documentElement.scrollHeight - window.innerHeight
  const top =
    centered <= margin ? 0 : Math.min(Math.max(centered, 0), Math.max(max, 0))

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  window.scrollTo({ top, behavior: behavior ?? (reduce ? 'auto' : 'smooth') })

  if (window.location.hash !== href) {
    window.history.replaceState(null, '', href)
  }

  return true
}
</file>

<file path="components/ui/AnimatedCounter.jsx">
'use client'

import { useEffect, useState } from 'react'
import { useInView } from '@/components/hooks/useInView.js'
import { useReducedMotion } from '@/components/hooks/useReducedMotion.js'

export default function AnimatedCounter({ value, prefix = '' }) {
  const [ref, visible] = useInView()
  const reduced = useReducedMotion()
  const [count, setCount] = useState(0)
  useEffect(() => {
    if (!visible || reduced) return
    let frame
    const start = performance.now()
    const tick = (now) => {
      const progress = Math.min((now - start) / 1400, 1)
      setCount(Math.round(value * progress))
      if (progress < 1) frame = requestAnimationFrame(tick)
    }
    frame = requestAnimationFrame(tick)
    return () => cancelAnimationFrame(frame)
  }, [visible, value, reduced])
  return <span ref={ref}>{prefix}{reduced ? value : count}</span>
}
